generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())

  name        String
  email       String   @unique
  password    String

  birthDate   DateTime?

  phone       String?
  city        String?
  state       String?

  avatar      String?

  createdAt   DateTime @default(now())

  rabbits     Rabbit[]
  posts       CommunityPost[]
}

model Rabbit {
  id          String   @id @default(cuid())

  name        String

  sex         String?

  breed       String?

  age         Int?

  weight      Float?

  color       String?

  image       String?

  birthDate   DateTime?

  ownerId     String

  owner       User @relation(fields: [ownerId], references: [id])

  createdAt   DateTime @default(now())
}

model CommunityPost {
  id          String   @id @default(cuid())

  title       String

  content     String

  authorId    String

  author      User @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
}